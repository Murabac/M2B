# Site. Production value is https://m2btek.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact (WhatsApp digits only, international format, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=252637744447
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_CONTACT_PHONE=(252) 63-7744447

# Analytics (Wave 7)
NEXT_PUBLIC_GA_ID=

# Supabase (Wave 3) — see supabase/README.md
# URL + anon key are PUBLIC by design (safe in the browser; RLS protects data).
# On Netlify: do NOT mark these as "Secret". Only the service role key is secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser / never mark as NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=
